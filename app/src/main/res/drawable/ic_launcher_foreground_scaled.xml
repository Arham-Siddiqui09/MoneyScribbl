<?xml version="1.0" encoding="utf-8"?>
<!--
    Wraps the foreground JPEG in an inset drawable with negative margins,
    which pushes the image outward and makes the icon artwork appear larger
    within the adaptive icon safe zone.

    Adaptive icon canvas = 108dp × 108dp.
    Safe zone (visible after masking) ≈ 72dp × 72dp centered.
    Negative inset of -14dp on all sides effectively scales the content
    up by ~26%, filling more of the safe zone with the brand mark.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground"
    android:insetLeft="-14dp"
    android:insetTop="-14dp"
    android:insetRight="-14dp"
    android:insetBottom="-14dp" />
